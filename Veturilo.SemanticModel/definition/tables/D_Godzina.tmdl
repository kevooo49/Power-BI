	partition D_Godzina = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    SELECTCOLUMNS ( GENERATESERIES ( 0, 23, 1 ), "Godzina", [Value] ),
				    "Okno", SWITCH ( TRUE (),
				        [Godzina] >= 6 && [Godzina] < 10, "Rano 6–10",
				        [Godzina] >= 16 && [Godzina] < 20, "Popołudnie 16–20",
				        "Pozostałe" )
				)

