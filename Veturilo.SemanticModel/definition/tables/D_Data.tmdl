	partition D_Data = calculated
		mode: import
		source =
				
				VAR Swieta = { DATE(2023,6,8), DATE(2023,8,15), DATE(2023,11,1), DATE(2023,11,11) }
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( DATE(2023,5,1), DATE(2023,11,30) ),
				    "Miesiac", FORMAT ( [Date], "yyyy-MM" ),
				    "Tydzien", WEEKNUM ( [Date], 21 ),
				    "DzienTygNr", WEEKDAY ( [Date], 2 ),
				    "DzienTyg", FORMAT ( [Date], "ddd" ),
				    "CzySwieto", [Date] IN Swieta,
				    "CzyRoboczy", WEEKDAY ( [Date], 2 ) <= 5 && NOT ( [Date] IN Swieta ),
				    "TypDnia", IF ( WEEKDAY ( [Date], 2 ) <= 5 && NOT ( [Date] IN Swieta ), "Roboczy", "Weekend/święto" )
				)

	annotation PBI_Id = 3619affda5f94076ba82f8bf7e968fe2

